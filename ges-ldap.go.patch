+// ===== GES PATCH START: AD binary conversion + ID selection =====
 func (c *ldapConnector) getAttr(e ldap.Entry, name string) string {
+	switch {
+	case strings.EqualFold(name, "objectGUID"), strings.EqualFold(name, "mS-DS-ConsistencyGuid"):
+		var raw []byte
+		for _, attr := range e.Attributes {
+			if strings.EqualFold(attr.Name, name) && len(attr.ByteValues) > 0 {
+				raw = attr.ByteValues[0]
+				break
+			}
+		}
+		if len(raw) != 16 {
+			return ""
+		}
+		return fmt.Sprintf(
+			"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+			raw[3], raw[2], raw[1], raw[0],
+			raw[5], raw[4],
+			raw[7], raw[6],
+			raw[8], raw[9],
+			raw[10], raw[11], raw[12], raw[13], raw[14], raw[15],
+		)
+
+	case strings.EqualFold(name, "objectSID"):
+		var raw []byte
+		for _, attr := range e.Attributes {
+			if strings.EqualFold(attr.Name, name) && len(attr.ByteValues) > 0 {
+				raw = attr.ByteValues[0]
+				break
+			}
+		}
+		if len(raw) < 8 {
+			return ""
+		}
+
+		subAuthorityCount := int(raw[1])
+		if len(raw) < 8+(subAuthorityCount*4) {
+			return ""
+		}
+
+		var identifierAuthority uint64
+		for _, b := range raw[2:8] {
+			identifierAuthority = (identifierAuthority << 8) | uint64(b)
+		}
+
+		sid := fmt.Sprintf("S-%d-%d", raw[0], identifierAuthority)
+		for i := 0; i < subAuthorityCount; i++ {
+			offset := 8 + (i * 4)
+			subAuthority := binary.LittleEndian.Uint32(raw[offset : offset+4])
+			sid += fmt.Sprintf("-%d", subAuthority)
+		}
+		return sid
+	}
+
 	if a := c.getAttrs(e, name); len(a) > 0 {
 		return a[0]
 	}
 	return ""
 }
 
+func (c *ldapConnector) getUserID(e ldap.Entry) string {
+	if c.UserSearch.PreferredIDAttr != "" {
+		if id := c.getAttr(e, c.UserSearch.PreferredIDAttr); id != "" {
+			return id
+		}
+	}
+
+	for _, attr := range c.UserSearch.IDAttr {
+		if c.UserSearch.PreferredIDAttr != "" && strings.EqualFold(attr, c.UserSearch.PreferredIDAttr) {
+			continue
+		}
+		if id := c.getAttr(e, attr); id != "" {
+			return id
+		}
+	}
+
+	return ""
+}
