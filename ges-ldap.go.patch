+// IdAttributes represents one or more LDAP attributes that can provide the
+// user's stable ID. It supports unmarshaling from both a single string
+// (e.g. "uid") and a list of strings (e.g. ["objectGUID", "mS-DS-ConsistencyGuid"]).
+// ===== GES PATCH START: Multi-value idAttr configuration =====
+type IdAttributes []string
+
+func (i *IdAttributes) UnmarshalJSON(data []byte) error {
+	var arr []string
+	if err := json.Unmarshal(data, &arr); err == nil {
+		*i = arr
+		return nil
+	}
+	var s string
+	if err := json.Unmarshal(data, &s); err != nil {
+		return fmt.Errorf("idAttr must be a string or list of strings")
+	}
+	if s != "" {
+		*i = IdAttributes{s}
+	}
+	return nil
+}
